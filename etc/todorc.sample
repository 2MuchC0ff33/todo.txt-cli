# todorc.sample - POSIX-OS config template (replaces todo.cfg for new stack).
# Copy to etc/todorc to use. All assignments are idempotent defaults:
# pre-exported environment values always win, so test harnesses can override.
: "${TODO_DIR:=$HOME/.todo}"
: "${TODO_FILE:=$TODO_DIR/todo.txt}"
: "${DONE_FILE:=$TODO_DIR/done.txt}"
: "${REPORT_FILE:=$TODO_DIR/report.txt}"
: "${TODOTXT_VERBOSE:=1}"
: "${TODOTXT_FORCE:=0}"
: "${TODOTXT_DATE_ON_ADD:=0}"
: "${TODOTXT_PRIORITY_ON_ADD:=}"
: "${TODOTXT_SORT_COMMAND:=env LC_COLLATE=C sort -f -k 2}"
